#!/bin/sh
#
# run_test - compile one test file, run it, and check what it claims.

set -u

PROG=$(basename "$0")
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

BIN="$HERE/build/bin"
TIMEOUT=5
HEAD_LINES=10
DEFAULT_PIPELINE=ivancc_linux
SOURCE=${1:-}

# Report a problem with the run and exit.
error()
{
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 2
}

# Report a passing test and exit.
pass()
{
    printf '\033[32mPASS\033[0m: %s\n' "$SOURCE"
    exit 0
}

# Report a failing test and exit.
fail()
{
    printf '\033[31mFAIL\033[0m: %s\n' "$SOURCE"
    { printf "$@"; printf '\n'; } | sed 's/^/    /' | sed '${/^ *$/d;}'
    exit 1
}

# Echo the value of a `// <key>:` line in a file.
get_value()
{
    head -n "$HEAD_LINES" "$1" \
        | sed -n "s@^// $2:[[:space:]]*@@Ip" \
        | sed 's/[[:space:]]*$//' \
        | head -n 1
}

# Echo the `// | ` lines under a `// <key>:` line in a file.
get_text()
{
    sed -n "/^\/\/ $2:\$/I,\$p" "$1" \
        | tail -n +2 \
        | sed -nE '/^\/\/ \|( |$)/!q; s///; p'
}

# Fail if the compiler timed out or died from a signal, whatever the test expects.
check_compiler()
{
    GOT="$(cat "${TMP}/compiler_status")"

    [ "$GOT" -ne 124 ] || fail 'Compiler timed out after %ss' "$TIMEOUT"
    [ "$GOT" -le 128 ] || fail 'Compiler died from signal %s:\n%s' "$((GOT - 128))" "$(cat "${TMP}/compiler_error")"
}

# Succeed if the build succeeded and the test expects something of the program.
# Fail on a compile failure the test does not expect.
wants_run()
{
    [ -s "${TMP}/expected_compiler_error" ] && return 1
    [ -s "${TMP}/expected_compiler_status" ] || grep -qx 0 "${TMP}/compiler_status" || fail '%s' "$(cat "${TMP}/compiler_error")"
    grep -qx 0 "${TMP}/compiler_status" || return 1
    [ -s "${TMP}/expected_status" ] || [ -s "${TMP}/expected_output" ]
}

# Build with ivancc straight to a Linux executable, and run it natively.
pipeline_ivancc_linux()
{
    cd "$(dirname -- "$SOURCE")" || error "cannot enter the directory of $SOURCE"
    timeout "$TIMEOUT" "${BIN}/ivancc" -o "${TMP}/a.out" $(cat "${TMP}/compiler_flags") "$(basename -- "$SOURCE")" >"${TMP}/compiler_output" 2>"${TMP}/compiler_error"
    echo $? > "${TMP}/compiler_status"
    check_compiler

    wants_run || return 0
    timeout "$TIMEOUT" "${TMP}/a.out" >"${TMP}/output" 2>&1
    echo $? > "${TMP}/status"
}

# Read the expectations, then build and run the test through its pipeline,
# recording results and expectations as files.
setup()
{
    [ -n "$SOURCE" ] || error "no test file given"
    [ -f "$SOURCE" ] || error "no such file: $SOURCE"
    [ -x "${BIN}/ivancc" ] || error "compiler not executable: ${BIN}/ivancc"

    TMP=$(mktemp -d) || error "cannot create a temporary directory"
    trap 'rm -rf "$TMP"' EXIT INT TERM

    get_value "${SOURCE}" '(Test) Pipeline' > "${TMP}/pipeline"
    get_value "${SOURCE}" '(Test) Compiler flags' > "${TMP}/compiler_flags"
    get_value "${SOURCE}" '(Test) Compiler status' > "${TMP}/expected_compiler_status"
    get_text "${SOURCE}" '(Test) Compiler output' > "${TMP}/expected_compiler_output"
    get_value "${SOURCE}" '(Test) Compiler error' > "${TMP}/expected_compiler_error"
    get_value "${SOURCE}" '(Test) Status' > "${TMP}/expected_status"
    get_text "${SOURCE}" '(Test) Output' > "${TMP}/expected_output"

    PIPELINE="$(cat "${TMP}/pipeline")"
    PIPELINE="${PIPELINE:-$DEFAULT_PIPELINE}"
    case "$PIPELINE" in
        *[!a-z0-9_]*) error "bad pipeline name: $PIPELINE" ;;
    esac
    command -v "pipeline_${PIPELINE}" >/dev/null || error "no such pipeline: $PIPELINE"

    : > "${TMP}/output"
    : > "${TMP}/status"
    "pipeline_${PIPELINE}"
}

# Check the compile failure against `// (Test) Compiler error:`.
test_compiler_error()
{
    EXP="$(cat "${TMP}/expected_compiler_error")"
    GOT="$(cat "${TMP}/compiler_error")"

    [ -n "$EXP" ] || return 0

    grep -qx 0 "${TMP}/compiler_status" && fail 'Compiled but expected %s' "$EXP"
    grep -qF "$EXP" "${TMP}/compiler_error" || fail 'Failed with:\n%s\nbut expected %s' "$GOT" "$EXP"

    pass
}

# Check the compiler's exit status against `// (Test) Compiler status:`.
test_compiler_status()
{
    EXP="$(cat "${TMP}/expected_compiler_status")"
    GOT="$(cat "${TMP}/compiler_status")"

    [ -n "$EXP" ] || return 0

    echo "$EXP" | grep -qv '^[0-9][0-9]*$' && fail "Compiler status expects a number between 0 and 255, got '%s'" "$EXP"
    [ "$EXP" -le 255 ] || fail "Compiler status expects a number between 0 and 255, got '%s'" "$EXP"

    [ "$GOT" -eq "$EXP" ] || fail 'Compiler returned %s but expected %s:\n%s' "$GOT" "$EXP" "$(cat "${TMP}/compiler_error")"
}

# Check the compiler's output against `// (Test) Compiler output:`.
test_compiler_output()
{
    EXP="$(cat "${TMP}/expected_compiler_output")"
    GOT="$(cat "${TMP}/compiler_output")"

    [ -n "$EXP" ] || return 0

    [ "$GOT" = "$EXP" ] || fail 'Compiler printed:\n%s\nbut expected:\n%s' "$GOT" "$EXP"
}

# Check the exit status against `// (Test) Status:`.
test_status()
{
    EXP="$(cat "${TMP}/expected_status")"
    GOT="$(cat "${TMP}/status")"

    [ -n "$EXP" ] || return 0

    echo "$EXP" | grep -qv '^[0-9][0-9]*$' && fail "Status expects a number between 0 and 255, got '%s'" "$EXP"
    [ "$EXP" -le 255 ] || fail "Status expects a number between 0 and 255, got '%s'" "$EXP"

    [ "$GOT" -ne "$EXP" ] || return 0
    [ "$GOT" -ne 124 ] || fail 'Timed out after %ss' "$TIMEOUT"
    [ "$GOT" -le 128 ] || fail 'Died from signal %s, expected to return %s' "$((GOT - 128))" "$EXP"

    fail 'Returned %s but expected %s' "$GOT" "$EXP"
}

# Check the program output against `// (Test) Output:`.
test_output()
{
    EXP="$(cat "${TMP}/expected_output")"
    GOT="$(cat "${TMP}/output")"

    [ -n "$EXP" ] || return 0
    [ "$(cat "${TMP}/status")" -ne 124 ] || fail 'Timed out after %ss' "$TIMEOUT"

    [ "$GOT" = "$EXP" ] || fail 'Printed:\n%s\nbut expected:\n%s' "$GOT" "$EXP"
}

# Fail a test that declares no expectation.
test_declared()
{
    [ -s "${TMP}/expected_compiler_status" ] && return
    [ -s "${TMP}/expected_compiler_output" ] && return
    [ -s "${TMP}/expected_status" ] && return
    [ -s "${TMP}/expected_output" ] && return
    fail 'No expectation declared'
}

setup
test_compiler_error
test_compiler_status
test_compiler_output
test_status
test_output
test_declared
pass
