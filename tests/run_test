#!/bin/sh
#
# run_test - compile one test file, run it, and check what it claims.

set -u

PROG=$(basename "$0")
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

BIN="$HERE/build/bin"
TIMEOUT=5
HEAD_LINES=10
SOURCE=${1:-}

# Report a problem with the run and exit.
error()
{
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 2
}

# Report a passing test and exit.
pass()
{
    printf '\033[32mPASS\033[0m: %s\n' "$SOURCE"
    exit 0
}

# Report a failing test and exit.
fail()
{
    printf '\033[31mFAIL\033[0m: %s\n' "$SOURCE"
    { printf "$@"; printf '\n'; } | sed 's/^/    /' | sed '${/^ *$/d;}'
    exit 1
}

# Echo the value of a `// <key>:` line in a file.
get_value()
{
    head -n "$HEAD_LINES" "$1" \
        | sed -n "s@^// $2:[[:space:]]*@@Ip" \
        | sed 's/[[:space:]]*$//' \
        | head -n 1
}

# Echo the `// | ` lines under a `// <key>:` line in a file.
get_text()
{
    sed -n "/^\/\/ $2:\$/I,\$p" "$1" \
        | tail -n +2 \
        | sed -nE '/^\/\/ \|( |$)/!q; s///; p'
}

# Compile and run the test, recording results and expectations as files.
setup()
{
    [ -n "$SOURCE" ] || error "no test file given"
    [ -f "$SOURCE" ] || error "no such file: $SOURCE"
    [ -x "${BIN}/ivancc" ] || error "compiler not executable: ${BIN}/ivancc"

    TMP=$(mktemp -d) || error "cannot create a temporary directory"
    trap 'rm -rf "$TMP"' EXIT INT TERM

    get_value "${SOURCE}" '(Test) Compiler output' > "${TMP}/exp.cout.txt"
    get_value "${SOURCE}" '(Test) Compiler return' > "${TMP}/exp.cret.txt"
    get_value "${SOURCE}" '(Test) Compiler error' > "${TMP}/exp.cerr.txt"
    get_value "${SOURCE}" '(Test) Return' > "${TMP}/exp.ret.txt"
    get_text "${SOURCE}" '(Test) Output' > "${TMP}/exp.out.txt"

    "${BIN}/ivancc" "$SOURCE" -o "${TMP}/a.out" >"${TMP}/got.cout.txt" 2>"${TMP}/got.cerr.txt"
    echo $? > "${TMP}/got.cret.txt"

    [ -s "${TMP}/exp.cerr.txt" ] && return
    grep -qx 0 "${TMP}/got.cret.txt" || fail '%s' "$(cat "${TMP}/got.cerr.txt")"

    timeout "$TIMEOUT" "${TMP}/a.out" >"${TMP}/got.out.txt" 2>&1
    echo $? > "${TMP}/got.ret.txt"
}

# Check the compile failure against `// (Test) Compiler error:`.
test_compiler_error()
{
    EXP="$(cat "${TMP}/exp.cerr.txt")"
    GOT="$(cat "${TMP}/got.cerr.txt")"

    [ -n "$EXP" ] || return 0

    grep -qx 0 "${TMP}/got.cret.txt" && fail 'Compiled but expected %s' "$EXP"
    grep -qF "[$EXP]" "${TMP}/got.cerr.txt" || fail 'Failed with:\n%s\nbut expected %s' "$GOT" "$EXP"

    pass
}

# Check the exit status against `// (Test) Return:`.
test_return()
{
    EXP="$(cat "${TMP}/exp.ret.txt")"
    GOT="$(cat "${TMP}/got.ret.txt")"

    [ -n "$EXP" ] || return 0

    echo "$EXP" | grep -qv '^[0-9][0-9]*$' && fail "Return expects a number between 0 and 255, got '%s'" "$EXP"
    [ "$EXP" -le 255 ] || fail "Return expects a number between 0 and 255, got '%s'" "$EXP"

    [ "$GOT" -ne "$EXP" ] || return 0
    [ "$GOT" -ne 124 ] || fail 'Timed out after %ss' "$TIMEOUT"
    [ "$GOT" -le 128 ] || fail 'Died from signal %s, expected to return %s' "$((GOT - 128))" "$EXP"

    fail 'Returned %s but expected %s' "$GOT" "$EXP"
}

# Check the program output against `// (Test) Output:`.
test_output()
{
    EXP="$(cat "${TMP}/exp.out.txt")"
    GOT="$(cat "${TMP}/got.out.txt")"

    [ -n "$EXP" ] || return 0
    [ "$(cat "${TMP}/got.ret.txt")" -ne 124 ] || fail 'Timed out after %ss' "$TIMEOUT"

    [ "$GOT" = "$EXP" ] || fail 'Printed:\n%s\nbut expected:\n%s' "$GOT" "$EXP"
}

# Fail a test that declares no expectation.
test_declared()
{
    [ -s "${TMP}/exp.ret.txt" ] && return
    [ -s "${TMP}/exp.out.txt" ] && return
    fail 'No expectation declared'
}

setup
test_compiler_error
test_return
test_output
test_declared
pass
