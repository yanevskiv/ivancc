#!/bin/sh
#
# run_test - check one test file's claims through every pipeline.

set -u

PROG=$(basename "$0")
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

BIN="$HERE/build/bin"
LIB="$HERE/build/lib/linux"
TIMEOUT=5
HEAD_LINES=10
PIPELINES="ivancc ivanas ivanld ivanemu"
PIPELINE=
SOURCE=${1:-}

# Report a problem with the run and exit.
error()
{
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 2
}

# Report a passing test and exit.
pass()
{
    printf '\033[32mPASS\033[0m: %s\n' "$SOURCE"
    exit 0
}

# Report a failing test and its pipeline, and exit.
fail()
{
    printf '\033[31mFAIL\033[0m: %s%s\n' "$SOURCE" "${PIPELINE:+ ($PIPELINE)}"
    { printf "$@"; printf '\n'; } | sed 's/^/    /' | sed '${/^ *$/d;}'
    exit 1
}

# Echo the value of a `// <key>:` line in a file.
get_line()
{
    head -n "$HEAD_LINES" "$1" \
        | sed -n "s@^// $2:[[:space:]]*@@Ip" \
        | sed 's/[[:space:]]*$//' \
        | head -n 1
}

# Echo the `// | ` lines under a `// <key>:` line in a file.
get_text()
{
    sed -n "/^\/\/ $2:\$/I,\$p" "$1" \
        | tail -n +2 \
        | sed -nE '/^\/\/ \|( |$)/!q; s///; p'
}

# Compile the test with ivancc, failing on a timeout or a crash.
stage_compile()
{
    timeout "$TIMEOUT" "${BIN}/ivancc" "$@" $(cat "${TMP}/compiler_flags") "$NAME" >"${RUN}/compiler_output" 2>"${RUN}/compiler_error"
    echo $? > "${RUN}/compiler_status"

    GOT="$(cat "${RUN}/compiler_status")"
    [ "$GOT" -ne 124 ] || fail 'Compiler timed out after %ss' "$TIMEOUT"
    [ "$GOT" -le 128 ] || fail 'Compiler died from signal %s:\n%s' "$((GOT - 128))" "$(cat "${RUN}/compiler_error")"
}

# True if the compile succeeded as expected, failing on an unexpected failure.
stage_compile_ok()
{
    [ -s "${TMP}/expected_compiler_error" ] && return 1
    [ -s "${TMP}/expected_compiler_status" ] || grep -qx 0 "${RUN}/compiler_status" || fail '%s' "$(cat "${RUN}/compiler_error")"
    grep -qx 0 "${RUN}/compiler_status"
}

# Run a build step after the compiler, failing if it fails.
stage_build()
{
    TOOL="$1"
    shift
    timeout "$TIMEOUT" "$@" >"${RUN}/build_error" 2>&1
    GOT=$?

    [ "$GOT" -ne 124 ] || fail '%s timed out after %ss' "$TOOL" "$TIMEOUT"
    [ "$GOT" -eq 0 ] || fail '%s returned %s:\n%s' "$TOOL" "$GOT" "$(cat "${RUN}/build_error")"
}

# True if the test expects something of the program.
stage_run_ok()
{
    [ -s "${TMP}/expected_status" ] || [ -s "${TMP}/expected_output" ]
}

# Run the program and record its output and status.
stage_run()
{
    { timeout "$TIMEOUT" "$@" >"${RUN}/output" 2>&1; } 2>/dev/null
    echo $? > "${RUN}/status"
}

# Build an executable with ivancc alone, and run it natively.
pipeline_ivancc()
{
    stage_compile -o "${RUN}/a.out"
    stage_compile_ok || return 0
    stage_run_ok || return 0
    stage_run "${RUN}/a.out"
}

# Build through assembly text and ivanas, link with gcc, and run natively.
pipeline_ivanas()
{
    stage_compile -S -o "${RUN}/a.s"
    stage_compile_ok || return 0
    stage_build ivanas "${BIN}/ivanas" -o "${RUN}/a.o" "${RUN}/a.s"
    stage_build gcc gcc -nostdlib -static -no-pie -o "${RUN}/a.out" "${RUN}/a.o" "${LIB}/crt0.o" "${LIB}/libc.o"
    stage_run_ok || return 0
    stage_run "${RUN}/a.out"
}

# Build an object, link it with ivanld, and run it natively.
pipeline_ivanld()
{
    stage_compile -c -o "${RUN}/a.o"
    stage_compile_ok || return 0
    stage_build ivanld "${BIN}/ivanld" -o "${RUN}/a.out" "${RUN}/a.o" "${LIB}/crt0.o" "${LIB}/libc.o"
    stage_run_ok || return 0
    stage_run "${RUN}/a.out"
}

# Build for ivanemu, and run it under the emulator.
pipeline_ivanemu()
{
    stage_compile -mtarget=ivanemu -o "${RUN}/a.out"
    stage_compile_ok || return 0
    stage_run_ok || return 0
    stage_run "${BIN}/ivanemu" "${RUN}/a.out"
}

# Read the test's expectations, and enter its directory.
setup()
{
    [ -n "$SOURCE" ] || error "no test file given"
    [ -f "$SOURCE" ] || error "no such file: $SOURCE"
    for TOOL in ivancc ivanas ivanld ivanemu; do
        [ -x "${BIN}/${TOOL}" ] || error "not executable: ${BIN}/${TOOL}"
    done

    TMP=$(mktemp -d) || error "cannot create a temporary directory"
    trap 'rm -rf "$TMP"' EXIT INT TERM

    get_line "${SOURCE}" '(Test) Compiler flags' > "${TMP}/compiler_flags"
    get_line "${SOURCE}" '(Test) Compiler status' > "${TMP}/expected_compiler_status"
    get_text "${SOURCE}" '(Test) Compiler output' > "${TMP}/expected_compiler_output"
    get_line "${SOURCE}" '(Test) Compiler error' > "${TMP}/expected_compiler_error"
    get_line "${SOURCE}" '(Test) Compiler warning' > "${TMP}/expected_compiler_warning"
    get_line "${SOURCE}" '(Test) Status' > "${TMP}/expected_status"
    get_text "${SOURCE}" '(Test) Output' > "${TMP}/expected_output"

    NAME="$(basename -- "$SOURCE")"
    cd "$(dirname -- "$SOURCE")" || error "cannot enter the directory of $SOURCE"
}

# Fail a test that declares no expectation.
test_declared()
{
    [ -s "${TMP}/expected_compiler_error" ] && return
    [ -s "${TMP}/expected_compiler_status" ] && return
    [ -s "${TMP}/expected_compiler_output" ] && return
    [ -s "${TMP}/expected_compiler_warning" ] && return
    [ -s "${TMP}/expected_status" ] && return
    [ -s "${TMP}/expected_output" ] && return
    fail 'No expectation declared'
}

# Check the compile failure against `// (Test) Compiler error:`.
test_compiler_error()
{
    EXP="$(cat "${TMP}/expected_compiler_error")"
    GOT="$(cat "${RUN}/compiler_error")"

    [ -n "$EXP" ] || return 0

    grep -qx 0 "${RUN}/compiler_status" && fail 'Compiled but expected %s' "$EXP"
    grep -qF "$EXP" "${RUN}/compiler_error" || fail 'Failed with:\n%s\nbut expected %s' "$GOT" "$EXP"
}

# Check the compiler's exit status against `// (Test) Compiler status:`.
test_compiler_status()
{
    EXP="$(cat "${TMP}/expected_compiler_status")"
    GOT="$(cat "${RUN}/compiler_status")"

    [ -n "$EXP" ] || return 0

    echo "$EXP" | grep -qv '^[0-9][0-9]*$' && fail "Compiler status expects a number between 0 and 255, got '%s'" "$EXP"
    [ "$EXP" -le 255 ] || fail "Compiler status expects a number between 0 and 255, got '%s'" "$EXP"

    [ "$GOT" -eq "$EXP" ] || fail 'Compiler returned %s but expected %s:\n%s' "$GOT" "$EXP" "$(cat "${RUN}/compiler_error")"
}

# Check the compiler's output against `// (Test) Compiler output:`.
test_compiler_output()
{
    EXP="$(cat "${TMP}/expected_compiler_output")"
    GOT="$(cat "${RUN}/compiler_output")"

    [ -n "$EXP" ] || return 0

    [ "$GOT" = "$EXP" ] || fail 'Compiler printed:\n%s\nbut expected:\n%s' "$GOT" "$EXP"
}

# Check the compiler's diagnostics against `// (Test) Compiler warning:`.
test_compiler_warning()
{
    EXP="$(cat "${TMP}/expected_compiler_warning")"
    GOT="$(cat "${RUN}/compiler_error")"

    [ -n "$EXP" ] || return 0

    grep -qF "$EXP" "${RUN}/compiler_error" || fail 'Warned with:\n%s\nbut expected %s' "$GOT" "$EXP"
}

# Check the exit status against `// (Test) Status:`.
test_status()
{
    EXP="$(cat "${TMP}/expected_status")"
    GOT="$(cat "${RUN}/status")"

    [ -n "$EXP" ] || return 0

    echo "$EXP" | grep -qv '^[0-9][0-9]*$' && fail "Status expects a number between 0 and 255, got '%s'" "$EXP"
    [ "$EXP" -le 255 ] || fail "Status expects a number between 0 and 255, got '%s'" "$EXP"

    [ "$GOT" -ne "$EXP" ] || return 0
    [ "$GOT" -ne 124 ] || fail 'Timed out after %ss' "$TIMEOUT"
    [ "$GOT" -le 128 ] || fail 'Died from signal %s, expected to return %s' "$((GOT - 128))" "$EXP"

    fail 'Returned %s but expected %s' "$GOT" "$EXP"
}

# Check the program output against `// (Test) Output:`.
test_output()
{
    EXP="$(cat "${TMP}/expected_output")"
    GOT="$(cat "${RUN}/output")"

    [ -n "$EXP" ] || return 0
    [ "$(cat "${RUN}/status")" -ne 124 ] || fail 'Timed out after %ss' "$TIMEOUT"

    [ "$GOT" = "$EXP" ] || fail 'Printed:\n%s\nbut expected:\n%s' "$GOT" "$EXP"
}

# Check one pipeline's results against the expectations.
test_pipeline()
{
    if [ -s "${TMP}/expected_compiler_error" ]; then
        test_compiler_error
        return
    fi
    test_compiler_status
    test_compiler_output
    test_compiler_warning
    test_status
    test_output
}

# Build, run and check the test through each pipeline in turn.
run_pipelines()
{
    for PIPELINE in $PIPELINES; do
        RUN="${TMP}/${PIPELINE}"
        mkdir "$RUN" || error "cannot create $RUN"
        : > "${RUN}/output"
        : > "${RUN}/status"
        "pipeline_${PIPELINE}"
        test_pipeline
    done
    PIPELINE=
}

setup
test_declared
run_pipelines
pass
